generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  mobile     String
  email      String   @unique
  profession String?
  city       String?
  state      String?
  createdAt  DateTime @default(now())
  demands    Demand[]

  @@map("users")
}

model Campaign {
  id                  Int      @id @default(autoincrement())
  name                String
  description         String?  @db.Text
  logo                String?
  certificateTemplate String?
  status              String   @default("active") // active, inactive
  demands             Demand[]

  @@map("campaigns")
}

model Demand {
  id           Int           @id @default(autoincrement())
  userId       Int
  campaignId   Int
  demandText   String?       @db.Text
  language     String        @default("english") // english, hindi, marathi
  demandDate   DateTime      @default(now())
  status       String        @default("completed")
  
  user         User          @relation(fields: [userId], references: [id])
  campaign     Campaign      @relation(fields: [campaignId], references: [id])
  certificates Certificate[]

  @@map("demands")
}

model Certificate {
  id                Int      @id @default(autoincrement())
  demandId          Int
  certificateNumber String   @unique
  pdfPath           String?
  verificationToken String   @unique
  generatedAt       DateTime @default(now())
  emailStatus       String   @default("pending") // pending, sent, failed

  demand Demand @relation(fields: [demandId], references: [id])

  @@map("certificates")
}


model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  role         String   @default("campaign_manager") // super_admin, campaign_manager, finance_admin, content_admin
  passwordHash String
  otp          String?
  otpExpiresAt DateTime?
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

model SiteConfig {
  id                Int      @id @default(1)
  demandEnglish     String?  @db.Text
  certificateFormat String?  @db.Text
  updatedAt         DateTime @default(now()) @updatedAt

  @@map("site_configs")
}
